<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent.
    cp scripts/com.rookery.daemon.plist ~/Library/LaunchAgents/
    # edit the ExecStart path below to match `which rookery`
    launchctl load ~/Library/LaunchAgents/com.rookery.daemon.plist
    tail -f /tmp/rookery.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rookery.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/rookery</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/rookery.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rookery.log</string>
</dict>
</plist>
