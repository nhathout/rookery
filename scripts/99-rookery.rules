# Linux udev rule: give your user access to the beacon without sudo, and
# create a stable /dev/rookery symlink so the port never moves.
#
#   sudo cp scripts/99-rookery.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Then: rookery run --port /dev/rookery
#
# Simpler alternative if you don't want a udev rule at all:
#   sudo usermod -aG dialout $USER   # then log out and back in

# CP2102
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", SYMLINK+="rookery"
# CH340 / CH9102
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", MODE="0666", SYMLINK+="rookery"
# Espressif native USB (S2/S3/C3/C6)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666", SYMLINK+="rookery"
